{
  "name": "marko-zag",
  "version": "1.1.0",
  "description": "Zag.js v1 bindings for Marko 6 — SSR-safe state machine adapter",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Saulo Vallory",
    "email": "saulo@toki.life",
    "url": "https://about.me/saulovallory"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/svallory/marko-zag"
  },
  "homepage": "https://marko-zag.saulo.tech",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./marko.json": "./marko.json"
  },
  "files": [
    "src",
    "marko.json"
  ],
  "scripts": {
    "check": "marko-type-check -p ./tsconfig.json -d condensed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "docs:dev": "docmd dev",
    "docs:build": "docmd build",
    "release": "./scripts/release.sh"
  },
  "dependencies": {
    "@zag-js/core": "^1.43.0",
    "@zag-js/types": "^1.43.0",
    "@zag-js/utils": "^1.43.0"
  },
  "peerDependencies": {
    "marko": "^6.3.34"
  },
  "devDependencies": {
    "@docmd/core": "^0.9.2",
    "@marko/type-check": "^2.0.0",
    "@marko/vite": "5",
    "@vitest/browser": "3.2.7",
    "@zag-js/checkbox": "^1.43.0",
    "@zag-js/combobox": "^1.43.0",
    "@zag-js/tooltip": "^1.43.0",
    "jsdom": "^25.0.0",
    "marko": "^6.3.34",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "marko",
    "zag",
    "zag-js",
    "state-machine",
    "headless",
    "a11y"
  ]
}
