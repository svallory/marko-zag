// Creates and owns a running Zag service — the Marko analog of Zag's
// `useMachine(machine, props)`. Returns a service GETTER, so the pair of
// lines reads exactly like Zag's own two:
//
//   <service/service machine=() => accordion.machine props=machineProps/>
//   <const/api=() => accordion.connect(service(), normalizeProps)/>
//   <div ...api().getRootProps()>
//
// `service()` returns the real running service on the client after mount,
// and a never-started throwaway (`ssrService`) on the server and before
// mount — Zag's `connect()` is a pure read, so that renders the correct
// initial attributes with no DOM access.
//
// A GETTER, not the service object, is load-bearing. Returning the service
// itself does NOT throw on the server: Marko serializes it with every
// function silently stripped, the page renders, and the first client read
// dies with `TypeError: … is not a function`. A closure written in this
// template is the only serializable stand-in for "a service", and calling
// it defers the real-vs-throwaway choice to call time.
//
// The getter's IDENTITY is the change signal. `_const` propagates only when
// the new value is `!==` the old one, so every machine notify — and every
// change to a value read inside the caller's `props` closure — must yield a
// FRESH closure. That is what makes a downstream
// `<const/api=() => m.connect(service(), normalizeProps)/>` recompute with
// no hand-written dependency list.
//
// `machine=` MUST be a getter closure written in the caller's template
// (`() => accordion.machine`): tag input is serialized for resume, and a raw
// machine (functions from npm code) throws `Unable to serialize "input"`.
import type { Machine, MachineSchema } from "@zag-js/core";
import { createService, ssrService, type MarkoService } from "../machine.ts";

export interface Input<T extends MachineSchema = MachineSchema> {
  /** Machine getter: `machine=() => accordion.machine` (never the raw machine). */
  machine: () => Machine<T>;
  /** machineProps closure: () => ({ id, ...mapped input }). Optional. */
  props?: () => Partial<T["props"]>;
}

static const EMPTY_PROPS = () => ({});

<let/rev=0/>
<let/instance=null as MarkoService<T> | null/>
<const/props=input.props ?? EMPTY_PROPS/>
<lifecycle
  onMount() {
    instance = createService(input.machine(), props, () => { rev += 1 });
    instance!.start();
  }
  onDestroy() {
    instance?.stop();
  }
/>
// Separate from the <lifecycle> above ON PURPOSE. A <script> compiles to an
// effect keyed on every binding it READS, so a <script> that both reads and
// writes one <let> re-subscribes on its own notifications. Creating the
// service here — where `props()` is read — would recreate it on every prop
// change. Assignment alone creates no dependency; this block only reads
// `props()` and `instance`, and calls a method.
<script>
  // Tracks every reactive read inside the caller's machineProps closure —
  // controlled props re-notify the machine without a hand-typed dep list.
  props();
  instance?.propsChanged();
</script>
// The eager reads are the getter's reactive dependencies; the comma discards
// them, but Babel counts the references all the same:
//   - `rev` — bumped by the machine's notify callback (transitions and
//     bindable context writes);
//   - `props()` — every tracked read inside the caller's machineProps
//     closure, so a controlled prop that only feeds Zag `computed(...)`
//     values still invalidates the getter.
// Each produces a FRESH closure, which is the only thing `_const` propagates
// on. Reads only, no writes — cannot loop.
//
// The arrow MUST be written directly as the <const> value. The compiler wraps
// a directly-written closure in `_resume(...)`, registering it so it can be
// serialized when the browser references it — which happens as soon as a
// consumer spreads `api()` onto an element. Wrapping it in an IIFE (as
// <store> does) yields an unregistered runtime closure and the render dies
// with `Unable to serialize "service"`. `void rev` keeps the dependency read
// while leaving the arrow in the value position (a bare `rev,` there is a
// TS "left side of comma operator is unused" error).
<const/service=(void rev, props(), () => instance ?? ssrService(input.machine(), props))/>
<return=service/>
