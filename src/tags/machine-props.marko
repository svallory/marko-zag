// Builds the machineProps closure for <service> from a component's input:
// picks the machine-owned props by name, injects a stable generated id
// (overridable via input.id), and merges every other attribute written on
// this tag — callback adaptations and inline overrides alike:
//
//   <machine-props/machineProps from=input pick=switchMachine.props
//     onCheckedChange(details) {
//       input.checkedChange?.(details.checked);
//     }/>
//   <service/service machine=() => switchMachine.machine props=machineProps/>
//
// `pick=` takes the machine's exported prop-name array (`switchMachine.props`
// — plain strings, serializable). Passing a split FUNCTION would hit the
// tag-input serialization wall; the name array is the serializable
// equivalent. The callback adaptation stays in the component file on
// purpose: it is the component's public contract.
export interface Input {
  /** The component's full input object. */
  from: Record<string, any>;
  /** Machine prop names — the machine module's exported `props` array. */
  pick: readonly string[];
  /** Anything else: callback adaptations and machine-prop overrides. */
  [override: string]: any;
}

<id/generatedId/>
<const/machineProps=() => {
  const { from, pick, ...overrides } = input;
  const picked: Record<string, any> = {};
  for (const name of pick) {
    if (from[name] !== undefined) picked[name] = from[name];
  }
  return { id: from.id ?? generatedId, ...picked, ...overrides };
}/>
<return=machineProps/>
