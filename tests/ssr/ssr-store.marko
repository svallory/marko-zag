// Server-rendered fixture for the <store> serialization regression.
//
// The load-bearing detail is the SPREAD: `...snap().attrs` makes the browser
// reference the store getter, which forces Marko to serialize it. A snapshot
// read in body content (`${snap().count}`) does not, which is why the tag
// shipped with an unregistered getter for so long without anyone noticing.
export interface Input {
  label: string;
}

<store/snap
  subscribe=(onChange: () => void) => () => {}
  snapshot=() => ({ attrs: { "data-count": "1", role: "status" }, count: 1 })
/>

<div ...snap().attrs class="fx-store">${snap().count}</div>
