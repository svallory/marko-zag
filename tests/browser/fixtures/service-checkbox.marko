// Fixture for the getter-service browser test: drives a real @zag-js/checkbox
// machine through the PUBLIC tag API — <machine-props> + <service> + a plain
// <const> calling connect(). That is the pattern the README documents, so
// this regression-tests the contract authors actually write.
//
// The observable is the rendered DOM, not any counter. `api` recomputes only
// when `service` changes identity, and every value below is read through
// `api()` — the root's `data-state`, the hidden input's `checked`, and the
// `.fx-state` text. So if the getter ever stopped returning a fresh closure,
// these attributes would freeze at their initial values while the machine
// itself kept transitioning. Asserting on them is what makes a stale getter
// visible from outside the tag.
import * as checkbox from "@zag-js/checkbox";
import { normalizeProps } from "../../../src/normalize-props.ts";

export interface Input {
  id: string;
  defaultChecked?: boolean;
}

<machine-props/machineProps from=input pick=checkbox.props/>
<service/service machine=() => checkbox.machine props=machineProps/>
<const/api=() => checkbox.connect(service(), normalizeProps)/>

<label ...api().getRootProps() class="fx-root">
  <input ...api().getHiddenInputProps() class="fx-input"/>
  <span ...api().getControlProps() class="fx-control"/>
  <span class="fx-state">${api().checked ? "on" : "off"}</span>
</label>
